# Local PostgreSQL on this machine (Neon-compatible).
DATABASE_URL=postgres://bcms:bcms_local_dev@127.0.0.1:5432/bcms_budget

# Neon cloud. After `npm run neon:setup`, replace DATABASE_URL with the
# pooled connection string it prints. Do not commit the live URL.
NEON_API_KEY=
NEON_PROJECT_NAME=BCMS budget
NEON_REGION=aws-us-east-1
PORT=8787
